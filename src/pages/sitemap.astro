---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

// Get all syllabus sections
const sections = await getCollection('sections')

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'Northfield Festival of Music & Speech homepage.',
  },
  {
    title: 'About',
    url: '/about',
    description: 'Information about the Northfield Festival of Music & Speech.',
  },
  {
    title: 'Syllabus',
    url: '/syllabus',
    description: 'The syllabus for the Northfield Festival of Music & Speech.',
  },
  {
    title: 'Speech Test Pieces',
    url: '/speech-test-pieces',
    description: 'A collection of speech test pieces for the Northfield Festival of Music & Speech.',
  },
  {
    title: 'Contact',
    url: '/contact',
    description:
      'Get in touch with us regarding the Northfield Festival of Music & Speech.',
  },
  {
    title: 'Privacy Policy',
    url: '/privacy-policy',
    description: 'Our privacy policy outlining how we handle user data and information.',
  },
  {
    title: 'Child Protection Policy',
    url: '/child-protection-policy',
    description: 'Our child protection policy outlining measures to ensure the safety and well-being of children.',
  },
  {
    title: 'Festival Rules',
    url: '/festival-rules',
    description: 'The rules and regulations governing the Northfield Festival of Music & Speech.',
  },
  {
    title: 'Accessibility statement',
    url: '/accessibility-statement',
    description: 'Our commitment to accessibility and information about the accessibility features of this website.',
  },
  {
    title: 'Thank you',
    url: '/thank-you',
    description: 'Confirmation page for successful form submissions and user interactions.',
  },
]
---

<DefaultLayout
  title="Sitemap"
  description="Complete site map showing all pages, syllabus sections, and sections available on our accessible website."
>
  <PageHeader
    title="Sitemap"
    subtitle="A comprehensive overview of all pages and content available on our website, organized for easy navigation."
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <!-- Main Pages Section -->
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Syllabus Sections Section -->
      <div>
        <Heading level="h2">Syllabus sections</Heading>
        <p class="mb-6">
          Explore our collection of {sections.length} accessibility-focused sections showcasing inclusive design and development
          practices.
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            sections.map((section) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/syllabus/${section.id}`}>{section.data.title}</a>
                </Heading>
                <p class="mb-3">{section.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    By: <span class="font-medium">{section.data.author}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /syllabus/{section.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Technical Information -->
      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML Sitemap:</span> An automated XML sitemap is generated at
              <code>/sitemap.xml</code>
              for search engine optimization.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap integration configured in astro.config.mjs
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
