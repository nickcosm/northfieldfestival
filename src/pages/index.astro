---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import ContentMedia from '@components/ContentMedia.astro'
import FeaturedSections from '@components/FeaturedSections.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Northfield Festival of Music & Speech" useTitleTemplate={false}>
  <Hero />
  <ContentMedia imgSrc="/15.webp">
    <Heading level="h2">Upcoming Festival - 2027</Heading>
    <p class="text-2xl">
      We are delighted to announce the launch of our 2027 Syllabus. We are looking forward to our Festival on Friday 14th and Saturday 15th May 2027 at Bishop Challoner Catholic College. Applications for the 2027 festival are now open. 
    Please visit our <Link href="/syllabus" isExternal>syllabus page</Link> to apply by post or <Link href="https://www.cognitoforms.com/NorthfieldFestivalOfMusicSpeech/OnlineApplicationNorthfieldFestival">apply online</Link>.
    </p>
  </ContentMedia>
  <FeaturedSections />

  <section class="my-64">
    <div class="space-content container">
      <Heading level="h2">Officers & Officials</Heading>
      <AvatarGroup display="grid" gridItemsSize="300px" gridGap="2rem">
        <Avatar initials="PD" title="Philip Dukes F.G.S.M. A.R.A.M" subtitle="President" />
        <Avatar initials="DB" title="Mrs Doreen Baggett" subtitle="Vice President" />
        <Avatar initials="EA" title="Mrs Eloise Akehurst" subtitle="Chair" />
        <Avatar initials="LA" title="Mrs Lucy Akehurst" subtitle="Vice Chair" />
        <Avatar initials="LL" title="Mrs Lin Le" subtitle="Treasurer" />
        <Avatar initials="JL" title="Mrs Justine Liu" subtitle="Secretary" />
        <Avatar initials="MB" title="Mrs Miriam Banting" subtitle="Member" />
        <Avatar initials="PF" title="Mrs Pat Finney" subtitle="Member" />
        <Avatar initials="JS" title="Mrs Jas Sandhu" subtitle="Member" />
        <Avatar initials="AT" title="Mrs Ann Tran" subtitle="Member" />
      </AvatarGroup>
    </div>
  </section>
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
