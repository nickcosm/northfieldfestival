---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'

// Import images directly for optimization
import sectionImage1 from '@assets/images/sections/any-instrument.webp'
import sectionImage2 from '@assets/images/sections/instrument-ensemble.webp'
import sectionImage3 from '@assets/images/sections/piano.webp'
import sectionImage4 from '@assets/images/sections/speech.webp'
import sectionImage5 from '@assets/images/sections/strings.webp'
import sectionImage6 from '@assets/images/sections/vocals.webp'

export const getStaticPaths = (async ({ paginate }) => {
  const sections = await getCollection('sections')
  const allTags = sections.map((section) => section.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const sectionImages = [sectionImage1, sectionImage2, sectionImage3, sectionImage4, sectionImage5, sectionImage6]

  const sectionsWithImages = sections.map((section, index) => {
    return {
      ...section,
      featuredImage: sectionImages[index % sectionImages.length],
    }
  })

  // Generate paginated pages for each tag
  const allPaginatedPages = []

  for (const tag of uniqueTags) {
    const filteredSections = sectionsWithImages.filter((section) =>
      section.data.tags.map((tag) => slugify(tag)).includes(tag.slug),
    )

    const paginatedPages = paginate(filteredSections, {
      pageSize: 6,
      params: { tag: tag.slug },
      props: {
        currentTag: tag,
        uniqueTags,
      },
    })

    allPaginatedPages.push(...paginatedPages)
  }

  return allPaginatedPages
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'sections'> & { featuredImage: any }>
  currentTag: { label: string; slug: string }
  uniqueTags: { label: string; slug: string }[]
}

const { page, currentTag, uniqueTags } = Astro.props
---

<DefaultLayout
  title={`Syllabus - ${currentTag.label}`}
  description={`Sections filtered by ${currentTag.label} tag. Discover our work in ${currentTag.label} and related technologies.`}
>
  <PageHeader
    title={`Syllabus: ${currentTag.label}`}
    subtitle={`Showing ${page.total} section${page.total !== 1 ? 's' : ''} tagged with "${currentTag.label}". <a href="/syllabus">View all sections</a> or filter by other tags below.`}
    bgType="bordered"
    customBreadcrumbLabels={{
      [currentTag.slug]: currentTag.label,
    }}
    joinLastBreadcrumb={true}
  />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        <Link href="/syllabus">All sections</Link>
        {
          uniqueTags.map((tag: { label: string; slug: string }) => {
            const isCurrentTag = tag.slug === currentTag.slug
            return isCurrentTag ? (
              <Link href={'/syllabus/tag/' + tag.slug} disabled class="disabled">
                {tag.label}
              </Link>
            ) : (
              <Link href={'/syllabus/tag/' + tag.slug}>{tag.label}</Link>
            )
          })
        }
      </div>
      <p class="mt-8 text-sm">
        <em
          >Section {page.start + 1} through {page.end + 1} of {page.total} total sections tagged with "{
            currentTag.label
          }"</em
        >
      </p>
      <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((section) => (
            <li>
              <Card
                imageComponent={section.featuredImage}
                url={'/syllabus/' + section.id}
                title={section.data.title}
                headingLevel="h2"
                footer={'Author: ' + section.data.author}
                fullHeight={true}
              >
                <span slot="meta">
                  {section.data.tags.map((tag) => {
                    const isCurrentTag = tag === currentTag.label
                    return isCurrentTag ? <Badge class="bg-blue-600 text-white">{tag}</Badge> : <Badge>{tag}</Badge>
                  })}
                </span>
                {section.data.description}
              </Card>
            </li>
          ))
        }
      </ul>

      <!-- Pagination -->
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? `/syllabus/tag/${currentTag.slug}` : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/syllabus/tag/${currentTag.slug}/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel={`${currentTag.label} syllabus pagination`}
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
