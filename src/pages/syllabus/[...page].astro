---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'

// Import images directly for optimization
import sectionImage1 from '@assets/images/sections/section-image-1.png'
import sectionImage2 from '@assets/images/sections/section-image-2.png'
import sectionImage3 from '@assets/images/sections/section-image-3.png'
import sectionImage4 from '@assets/images/sections/section-image-4.png'
import sectionImage5 from '@assets/images/sections/section-image-5.png'
import sectionImage6 from '@assets/images/sections/section-image-6.png'

export const getStaticPaths = (async ({ paginate }) => {
  const sections = await getCollection('sections')
  const allTags = sections.map((section) => section.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const sectionImages = [sectionImage1, sectionImage2, sectionImage3, sectionImage4, sectionImage5, sectionImage6]

  const sectionsWithImages = sections.map((section, index) => {
    return {
      ...section,
      featuredImage: sectionImages[index % sectionImages.length],
    }
  })

  return paginate(sectionsWithImages, {
    pageSize: 6,
    props: { uniqueTags },
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'sections'> & { featuredImage: any }>
  uniqueTags: { label: string; slug: string }[]
}

const { page, uniqueTags } = Astro.props
---

<DefaultLayout
  title="Syllabus"
  description="A showcase of sections built with Astro Content Collections, demonstrating dynamic content management."
>
  <PageHeader
    title="Syllabus"
    subtitle='A showcase of sections built with Astro Content Collections, demonstrating dynamic content management and organization. Learn more about <a href="https://docs.astro.build/en/guides/content-collections/">Astro Content Collections</a> in the official documentation.'
    bgType="bordered"
  />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag: { label: string; slug: string }) => (
            <Link href={'/syllabus/tag/' + tag.slug}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>Section {page.start + 1} through {page.end + 1} of {page.total} total sections</em>
      </p>
      <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((section) => (
            <li>
              <Card
                imageComponent={section.featuredImage}
                url={'/syllabus/' + section.id}
                title={section.data.title}
                headingLevel="h2"
                footer={'Author: ' + section.data.author}
                fullHeight={true}
              >
                <span slot="meta">
                  {section.data.tags.map((tag) => (
                    <Badge>{tag}</Badge>
                  ))}
                </span>
                {section.data.description}
              </Card>
            </li>
          ))
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? '/syllabus' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/syllabus/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Syllabus pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
