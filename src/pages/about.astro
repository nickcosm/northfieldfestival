        <Heading level="h3">Members</Heading>
        <p>Mrs Miriam Banting</p>
        <p>Mrs Pat Finney</p>
        <p>Mrs Jas Sandhu</p>
        <p>Mrs Ann Tran</p>
        <Heading level="h3">Committee Associates</Heading>
