---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <CallToAction />
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Features</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/about">About the Festival</Link></li>
          <li><Link href="/syllabus">Apply by Post</Link></li>
          <li><Link isExternalhref="https://www.cognitoforms.com/NorthfieldFestivalOfMusicSpeech/OnlineApplicationNorthfieldFestival">Apply Online</Link></li>
          <li><Link href="/sitemap">Sitemap</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Policies & Rules</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link href="/privacy-policy">Privacy Policy</Link>
          </li>
          <li>
            <Link href="/child-protection-policy">Child Protection Policy</Link>
          </li>
          <li>
            <Link href="/festival-rules">Festival Rules</Link>
          </li>         
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Contact Details</Heading>
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:phone" size={20} class="shrink-0" />
          <p>
            <span class="font-bold">Phone:</span>
            <Link href="tel:01214711583">+44 121 471 1583</Link>
          </p>
        </div>

        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:mail" size={20} class="shrink-0" />
          <p>
            <span class="font-bold">Email:</span>
            <Link href="mailto:info@northfieldfestival.org.uk">info@northfieldfestival.org.uk</Link>
          </p>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p class="leading-[1.75]">
          Registered Charity Number: 1003470
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - Northfield Festival of Music & Speech.
      </p>
      <p>
        Site by <Link href="https://github.com/nickcosm">NC</Link>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
