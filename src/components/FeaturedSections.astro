---
import { Card, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

// Import images directly for optimization
import sectionImage1 from '@assets/images/sections/any-instrument.webp'
import sectionImage2 from '@assets/images/sections/instrument-ensemble.webp'
import sectionImage3 from '@assets/images/sections/piano.webp'
import sectionImage4 from '@assets/images/sections/speech.webp'
import sectionImage5 from '@assets/images/sections/strings.webp'
import sectionImage6 from '@assets/images/sections/vocals.webp'

/**
 * FeaturedSections Component
 *
 * @description A component that displays featured sections from Astro Content Collections
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The number of sections to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Syllabus"
   */
  title?: string
}

const { class: className, limit = 6, title = 'Syllabus' } = Astro.props

// Get sections from content collection
const sections = await getCollection('sections')
const sectionImages = [sectionImage1, sectionImage2, sectionImage3, sectionImage4, sectionImage5, sectionImage6]

// Limit sections and add featured images
const featuredSections = sections.slice(0, limit).map((section, index) => ({
  ...section,
  featuredImage: sectionImages[index % sectionImages.length],
}))
---

<section class:list={[className, 'my-64']}>
  <div class="container">
    <Heading level="h2" class="mb-6">{title}</Heading>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredSections.map((section) => (
          <Card
            imageComponent={section.featuredImage}
            url={'/syllabus/' + section.id}
            headingLevel="h2"
            title={section.data.title}
            footer={'Author: ' + section.data.author}
          >
            {section.data.description}
          </Card>
        ))
      }
    </div>
    <div class="mt-12">
      <Link href="/syllabus/" isButton animateOnHover animationType="nudge">
        View all sections
        <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
      </Link>
    </div>
  </div>
</section>
